# ==============================================================================
# AMANAH CAPITAL - PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` on your deployment server (cPanel / Cloud / VPS)
# and fill in your actual production credentials.
# NEVER commit the real `.env` file to Git or version control!

# ------------------------------------------------------------------------------
# 1. Server Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080

# ------------------------------------------------------------------------------
# 2. Database Connection (MySQL / MariaDB on cPanel)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanel_database_name
DB_USER=your_cpanel_database_user
DB_PASSWORD=your_strong_database_password
DB_CONNECTION_LIMIT=20
DB_USE_SSL=false

# ------------------------------------------------------------------------------
# 3. Security, Token & Session Secrets
# ------------------------------------------------------------------------------
# Generate cryptographically secure 64-char strings via:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_random_jwt_secret_minimum_32_characters
JWT_EXPIRY=24h
SESSION_SECRET=replace_with_strong_random_session_secret_minimum_32_characters

# ------------------------------------------------------------------------------
# 4. Rate Limiting Protection (Brute Force Defense)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=50
