<% layout('layouts/main') %>

<div class="dashboard-app-container">
  
  <div class="app-header-back" style="margin-bottom: 2rem;">
    <a href="/customer/dashboard" class="back-btn"><i class="fa-solid fa-arrow-left"></i></a>
    <h1 class="page-title-center">Online Payments</h1>
  </div>

  <div class="glass-panel text-center" style="padding: 3rem 1.5rem; border-radius: 20px; background: #ffffff; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-top: 2rem;">
    <div style="font-size: 3rem; margin-bottom: 1.5rem;">🚧</div>
    <h2 style="color: #0f172a; font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Online Payments Coming Soon</h2>
    
    <p style="color: #64748b; font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.5rem;">
      Our online payment system is currently under development.
    </p>

    <div style="background: rgba(245, 158, 11, 0.1); border-left: 4px solid #f59e0b; padding: 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; text-align: left;">
      <p style="color: #92400e; font-size: 1rem; margin: 0; line-height: 1.5;">
        <strong>For now,</strong> please make your loan repayment directly to the loan owner/lender using the payment instructions provided by them.
      </p>
    </div>

    <p style="color: #64748b; font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
      Thank you for your patience—we'll make online payments available soon.
    </p>

    <a href="/customer/dashboard" class="btn btn-primary" style="padding: 0.75rem 2rem; border-radius: 999px;">Return to Dashboard</a>
  </div>

  <!-- Mobile Bottom Navigation -->
  <nav class="bottom-nav">
    <a href="/customer/dashboard" class="nav-item">
      <i class="fa-solid fa-building-columns"></i>
      <span>Home</span>
    </a>
    <a href="/customer/loans" class="nav-item">
      <i class="fa-solid fa-file-invoice"></i>
      <span>Loan</span>
    </a>
    <a href="/customer/apply" class="nav-item">
      <i class="fa-regular fa-calendar-check"></i>
      <span>Apply</span>
    </a>
    <a href="/customer/profile" class="nav-item">
      <i class="fa-regular fa-user"></i>
      <span>Profile</span>
    </a>
  </nav>

</div>
